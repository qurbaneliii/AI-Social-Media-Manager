ARIA_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aria
JWT_SECRET=replace-with-the-same-long-secret-used-by-the-frontend
ARIA_JWT_ISSUER=aria-frontend
ARIA_JWT_AUDIENCE=aria-api
CORS_ORIGINS=http://localhost:3000

# Demo output is opt-in. Keep false for connected environments.
AI_MOCK_MODE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.4
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_SECONDS=45
