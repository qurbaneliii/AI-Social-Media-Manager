# Frontend app runtime configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Primary backend API base URL used by aria-frontend/lib/api.ts.
# For Vercel-only preview mode, leave these empty and set NEXT_PUBLIC_PREVIEW_MODE=true.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Legacy alias still used by older frontend modules.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional dedicated base URL for the LLM orchestration approval API.
# When unset, approval UI falls back to NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_AI_ORCHESTRATION_URL=http://localhost:8000

# Supabase browser-safe configuration. These values are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Server-only Supabase key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Auth signing secret for the current app/api/auth/* Prisma routes.
# Keep this while migrating fully to Supabase Auth.
JWT_SECRET=replace-with-a-long-random-secret

# OpenAI key used by app/api/ai/* route handlers. Server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2

# Anthropic key used by app/api/generate streaming route. Server-only.
ANTHROPIC_API_KEY=

# Optional preview banner toggle for dashboard shell.
NEXT_PUBLIC_PREVIEW_MODE=true

# Browser-side timeout/retry controls for AI endpoint calls.
NEXT_PUBLIC_AI_REQUEST_TIMEOUT_MS=45000
NEXT_PUBLIC_AI_REQUEST_RETRIES=2

# Prisma datasource for current auth routes and seed script.
# Use the Supabase pooled or direct Postgres connection string in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aria
